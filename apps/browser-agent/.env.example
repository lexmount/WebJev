# Server-side settings only. Never expose them to the browser (no VITE_* variables).

# Browser: Lexmount Browser (cloud) or your own Chrome.
# Lexmount Browser: get an API key and project ID at https://browser.lexmount.com/
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
# Local Chrome started with --remote-debugging-port (see README).
CHROME_CDP_URL=http://127.0.0.1:9222
# lexmount or local. Empty: lexmount when LEXMOUNT_API_KEY is set, otherwise local.
BROWSER=

# Decision model: configure one or both; the page lets the user pick among the configured ones.
# WebJev-35B-A3B behind a Jev-compatible endpoint, e.g. the server in evaluation/serving.
DECISION_URL=
DECISION_API_KEY=
DECISION_MODEL=webjev-35b-a3b
# Jev 1.13 through TypeSafe's API or through OpenRouter.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Preselected model when both are configured: webjev or jev.
BROWSER_AGENT_DEFAULT_DECISION=webjev

# Text helper (any OpenAI-compatible chat API): plans the task, writes the text to type, writes the final summary.
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL=deepseek-v4.1-flash

# App settings
BROWSER_AGENT_SESSION_SECRET=
# Lexmount Browser only: idle sessions kept ready to cut start-up time (each one is a live cloud browser). 0 = off.
BROWSER_AGENT_POOL_SIZE=0
BROWSER_AGENT_MAX_ACTIVE=3
BROWSER_AGENT_MAX_SECONDS=900
BROWSER_AGENT_HOURLY_LIMIT=40
# Time zone for relative dates in tasks ("tomorrow", "next Monday").
BROWSER_AGENT_TIMEZONE=UTC
