{
 "task_id": "vts-044-craigslist-sfbay-iphonex-good-max400-titles",
 "task_name": "On the SF Bay Area craigslist (sfbay.craigslist.org), browse iPhone X for sale with condition set to good, a maximum price of $400, and search in titles only. Leave the filtered search results open.",
 "website": "https://sfbay.craigslist.org/",
