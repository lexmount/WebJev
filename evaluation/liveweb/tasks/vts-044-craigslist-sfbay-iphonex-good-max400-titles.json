  "original_task_name": "Browse iPhone X for sale that is in good condition, has a max price of 400, and searches in titles only.",
  "original_website": "https://craigslist.org/",
  "source_row_zero_based": 193,
  "intent_modified": true,
  "intent_modified_reason": "The original task names no region; the city is fixed to the San Francisco Bay Area so the cloud browser's exit location cannot choose it. All four conditions (iPhone X, good condition, at most $400, titles only) are kept."
 },
 "evaluator": {
