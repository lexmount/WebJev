    "name": "category_is_for_sale",
    "metric": "url_pattern_match",
    "result": {
     "type": "final_url"
    },
    "expected": {
     "type": "const",
     "value": "(?:[?&]cat=(?:sss|ppa|ara|sna|pta|ava|baa|bar|haa|bip|bia|bpa|boo|boa|bka|bfa|cta|ema|moa|cla|cba|syp|sya|ela|gra|hva|jwa|maa|mpa|mca|msa|pha|rva|sga|tia|tla|taa|tra|vga|wta|fua|hsa|ata|foa|zip|gms|fuo|fud|hso|hsd|ato|atd|foo|fod|sso|ssd)(?:[&#]|$)|/search/(?:[a-z]{3}/)?(?:sss|ppa|ara|sna|pta|ava|baa|bar|haa|bip|bia|bpa|boo|boa|bka|bfa|cta|ema|moa|cla|cba|syp|sya|ela|gra|hva|jwa|maa|mpa|mca|msa|pha|rva|sga|tia|tla|taa|tra|vga|wta|fua|hsa|ata|foa|zip|gms|fuo|fud|hso|hsd|ato|atd|foo|fod|sso|ssd)(?:[/?#]|$))"
    }
   },
