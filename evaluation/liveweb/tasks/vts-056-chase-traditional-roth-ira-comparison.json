{
 "task_id": "vts-056-chase-traditional-roth-ira-comparison",
 "task_name": "On the Chase official IRA calculator hosted at static.chasecdn.com (the supplied starting page), display the Traditional versus Roth IRA comparison chart for current age 30, retirement age 65, monthly contribution $300, annual return 3%, current tax rate 13%, and retirement tax rate 24%. Keep the starting balance at $0. Leave the chart open with these inputs and the calculated comparison displayed.",
 "website": "https://static.chasecdn.com/web/library/uswmdreui/retirement-calculators-iframes/2.0.6/index.html#/dashboard/retirementCalculators/iraCalculator",
 "source": {
  "benchmark": "Online-Mind2Web",
  "task_id": "9ed3827266b3b804f485859c3d00401e",
  "original_task_name": "If I'm 30, plan to retire at 65, and can save $300/month, with a 3% annual return, 13% current tax rate, and 24% retirement tax rate, show the comparison chart between Traditional and Roth IRA.",
  "original_website": "https://www.chase.com/",
  "source_row_zero_based": 208,
  "intent_modified": true,
  "intent_modified_reason": "Kept all six inputs and the Traditional vs. Roth comparison chart. The task starts on the official calculator page that chase.com embeds (same reason as vts-055). The initial balance, which the original task does not give, stays at the default 0; the chart must stay on screen."
 },
 "evaluator": {
  "spec_version": "1",
