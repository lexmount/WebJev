{
 "task_id": "vts-060-weathernetwork-10019-current-temperature",
 "task_name": "On theweathernetwork.com, look up the current temperature for ZIP code 10019. Leave the resulting Current Weather page open. Return only a JSON object with string fields \"temperature\" (the current temperature number, without the degree symbol) and \"unit\" (\"C\" or \"F\" as displayed).",
 "website": "https://www.theweathernetwork.com/",
 "source": {
  "benchmark": "Online-Mind2Web",
