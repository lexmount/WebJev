  "original_task_name": "Look up the current temperature for zip code 10019.",
  "original_website": "https://www.theweathernetwork.com/",
  "source_row_zero_based": 184,
  "intent_modified": true,
  "intent_modified_reason": "Kept the current temperature for ZIP code 10019; the site and the result page are explicit, and the answer gives the live temperature and unit for a deterministic comparison. The site resolves 10019 to Manhattan, New York."
 },
 "evaluator": {
  "spec_version": "1",
  "conj": "and",
  "checks": [
