{
 "task_id": "vts-063-mayo-sharp-chest-pain-with-anxiety",
 "task_name": "On mayoclinic.org, use the Symptom Checker to find possible causes of adult chest pain described as Sharp and accompanied by Anxiety. Select only those two factors, leave the View possible causes results open, and return only a JSON object with a \"causes\" array listing every displayed condition name.",
 "website": "https://www.mayoclinic.org/",
 "source": {
  "benchmark": "Online-Mind2Web",
  "task_id": "8103786e0e5976ebf961bd062d5f39cd",
  "original_task_name": "Find possible causes for the symptoms of chest pain which is sharp which is accompanied by anxiety.",
  "original_website": "https://www.mayoclinic.org/",
  "source_row_zero_based": 139,
  "intent_modified": true,
  "intent_modified_reason": "Kept chest pain, sharp, anxiety and possible causes. The task uses the site's adult symptom checker, selects only the two factors named in the task, ends on the results page and returns the condition names as a JSON list for item-by-item comparison. The list of possible causes is not a diagnosis."
 },
 "evaluator": {
  "spec_version": "1",
  "conj": "and",
  "checks": [
