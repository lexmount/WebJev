    "metric": "url_pattern_match",
    "result": {
     "type": "final_url"
    },
    "expected": {
     "type": "const",
     "value": "^https://www\\.coolmath4kids\\.com/sites/default/files/practice\\-tool/multiply\\.html$"
    }
   },
   {
    "name": "quiz_settings",
    "metric": "json_object_match",
    "result": {
     "type": "control_state",
     "selectors": {
      "range": "#range",
      "questions": "#questions",
      "time": "#timePerQuestion"
     },
     "must_exist": [
      "range",
      "questions",
      "time"
     ]
    },
    "expected": {
     "type": "const",
     "value": {
      "range.value": {
       "eq": "11-12"
      },
      "questions.value": {
       "eq": "10"
      },
      "time.value": {
       "eq": "unlimited"
      }
     }
    },
    "requires": [
     "on_official_multiplication_tool"
    ]
   },
   {
    "name": "result_page_visible",
    "metric": "include_exclude",
    "result": {
     "type": "visible_text",
     "selector": "#results-container"
    },
    "expected": {
     "type": "const",
     "value": {
      "must_include": [
       "Multiplication: 11-12,",
       "unlimited seconds"
      ]
     }
    },
    "requires": [
     "on_official_multiplication_tool"
    ]
   },
   {
    "name": "perfect_score",
    "metric": "json_object_match",
    "result": {
