    "expected": {
     "type": "const",
     "value": {
      "score": {
       "eq": "10 out of 10"
      }
     }
    },
    "requires": [
     "on_official_multiplication_tool",
     "result_page_visible"
    ]
   },
   {
    "name": "ten_correct_answers",
    "metric": "count_in_range",
    "result": {
