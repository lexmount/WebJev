  "original_website": "https://www.healthline.com/",
  "source_row_zero_based": 129,
  "intent_modified": true,
  "intent_modified_reason": "Kept the question about the recommended dosage; the answer is now a JSON object with explicit fields and units so dose, interval and route can be checked deterministically. The question was not replaced by navigation alone."
 },
