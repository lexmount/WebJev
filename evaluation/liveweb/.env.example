# Copy to .env and fill in. Never commit the filled file.

# Browser: lexmount (Lexmount Browser, the reported runs) or local (your own Chrome).
BROWSER=lexmount

# Lexmount Browser (https://browser.lexmount.com): API key and project ID of your account.
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=

# Local Chrome: start it with --remote-debugging-port=9222 --user-data-dir=<a separate profile directory>.
CHROME_CDP_URL=http://127.0.0.1:9222
# Parallel episodes on one local Chrome (each gets its own browser context).
LOCAL_CHROME_WORKERS=2

# Text helper: any OpenAI-compatible endpoint. It writes the text for TYPE_TEXT actions and the final answer after
# the agent stops; decision models only choose and cannot generate text. The reported runs used deepseek-v4.1-flash.
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL=deepseek-v4.1-flash

# Decision-model keys, referenced by name from models.conf (key_env column).
WEBJEV_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional: interpreter with the agent's requirements (default: python3).
WEBJEV_AGENT_PYTHON=
